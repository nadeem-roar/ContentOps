# ---- Supabase (company Supabase account only) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated email domains allowed to sign in via Google SSO.
ALLOWED_EMAIL_DOMAINS=creatorflow.com.au

# ---- Google Drive (service account, domain-wide delegation) ----
# Create in the company GCP project. Store the JSON in Vercel env, not in the repo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=contentops-drive@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Shared Drive (or folder) ID that all client folders are created under.
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_ROOT_FOLDER_ID
# Optional: user to impersonate for domain-wide delegation.
GOOGLE_DRIVE_IMPERSONATE_USER=ops@creatorflow.com.au

# ---- Automation worker ----
# Random secret; required as a Bearer token on /api/cron/* routes.
CRON_SECRET=generate_a_long_random_string
